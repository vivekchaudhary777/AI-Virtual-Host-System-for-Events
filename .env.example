PORT=5000
MONGO_URI=mongodb://localhost:27017/virtual-event-platform
JWT_SECRET=your_jwt_secret_here
# Get your FREE gemini key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: OpenAI key if still used for networking logic
AI_SERVICE_API_KEY=your_openai_api_key_here

# LangChain Tracing (LangSmith)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT="virtual-event-platform"
